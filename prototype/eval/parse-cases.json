        "data": { "from": "NRT", "to": "PVG", "mode": "air", "code": "MU524" } }]
    },
    {
      "id": "leg-新干线-无车次",
      "in": "3/16 京都 → 东京 新干线 のぞみ 226 号",
      "want": [{ "type": "leg", "time": { "start": "2026-03-16" },
        "data": { "from": "京都", "to": "东京", "mode": "rail", "code": "" } }]
    },
    {
